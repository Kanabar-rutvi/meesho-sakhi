# Meesho Sakhi Frontend Environment Configuration
# ================================================
# Copy this file to .env.local and update values as needed
# IMPORTANT: Environment variables are injected by Vite at BUILD TIME, not runtime

# REQUIRED FOR PRODUCTION: Backend API URL
# ==========================================
# This is the ONLY variable needed for production deployment.
#
# For local development:
#   VITE_API_URL=http://localhost:8000
#   (or leave empty to use default: http://localhost:8000)
#
# For production:
#   Set before building: export VITE_API_URL=https://your-backend-domain.com
#   Then rebuild: npm run build
#   Then deploy dist/ to Vercel
#
# If using Vercel:
#   1. Go to Project Settings → Environment Variables
#   2. Add: VITE_API_URL = https://your-deployed-backend-domain.com
#   3. Redeploy to apply the new variable
#
# IMPORTANT: 
#   - Do NOT include trailing slash (/)
#   - For production, this MUST match where your FastAPI backend is deployed
#   - Example values:
#       - https://meesho-sakhi-api.example.com
#       - https://api.example.com
#       - https://backend.vercel.app
#       - https://your-heroku-app.herokuapp.com

VITE_API_URL=

# Feature Flags (optional)
VITE_ENABLE_VOICE_INPUT=true
VITE_ENABLE_REFINEMENT=true

