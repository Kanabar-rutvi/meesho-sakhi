# Frontend Environment Variables
# Copy this file to .env.local and update values as needed

# API Configuration
# For local development: leave empty (will use proxy) or use http://localhost:8000
# For production: use your deployed backend URL (e.g., https://api.meesho-sakhi.app)
VITE_API_URL=

# Backend Base URL (for deployed environments)
# Example: https://api.example.com or https://example.com/api
# If set, this overrides the default behavior
# VITE_BACKEND_URL=

# Feature Flags
VITE_ENABLE_VOICE_INPUT=true
VITE_ENABLE_REFINEMENT=true
