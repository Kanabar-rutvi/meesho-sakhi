# Meesho Sakhi Backend Environment Configuration
# ===============================================
# Copy this file to .env and update values as needed

# Server Configuration
# ====================
HOST=0.0.0.0
PORT=8000
ENV=development

# CORS Configuration (CRITICAL FOR PRODUCTION)
# ============================================
# Comma-separated list of allowed origins.
# MUST include the domain where your frontend is deployed.
#
# For local development:
#   ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000
#
# For production:
#   ALLOWED_ORIGINS=https://your-frontend-domain.com,https://your-frontend-domain.vercel.app
#   Example: ALLOWED_ORIGINS=https://meesho-sakhi.vercel.app
#
# If frontend and backend are on the same domain:
#   ALLOWED_ORIGINS=https://yourdomain.com
#
# IMPORTANT: Must match where your frontend is deployed!

ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000

# API Keys (REQUIRED FOR PRODUCTION)
# ==================================

# Anthropic Claude API Key (REQUIRED)
# Get from: https://console.anthropic.com/
# The 8-agent pipeline uses Claude API for all agent decisions
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Database Configuration
# ======================
# For local development: SQLite (default, no setup needed)
# For production: Consider PostgreSQL or managed database
DATABASE_URL=sqlite:///./meesho_sakhi.db

# Feature Flags
ENABLE_MEESHO_INTEGRATION=false
ENABLE_PAYMENT_PROCESSING=false

# Logging
LOG_LEVEL=INFO

# Deployment Notes
# ================
# When deploying to production:
#
# 1. Set ANTHROPIC_API_KEY to your actual API key
#    Do NOT commit .env file to git (it's in .gitignore)
#
# 2. Set ALLOWED_ORIGINS to include your frontend domain
#    Example: ALLOWED_ORIGINS=https://myapp.vercel.app
#
# 3. For database:
#    - SQLite works for demos but NOT recommended for production
#    - If using SQLite, ensure the filesystem is persistent
#    - For production, use PostgreSQL or managed database
#
# 4. Set ENV=production for production deployments
#    ENV=production
#
# 5. Start backend with:
#    uvicorn main:app --host 0.0.0.0 --port $PORT
#    (Most hosting platforms provide $PORT via environment variable)

