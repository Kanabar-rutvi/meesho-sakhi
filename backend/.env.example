# Database Configuration (PostgreSQL / Supabase)
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Authentication & Security
JWT_SECRET=your_jwt_secret_hex_string
CONVERSATION_ENCRYPTION_KEY=your_conversation_encryption_32byte_hex_key
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000,http://localhost:5174
PORT=8000

# AI Shopping Intelligence & Claude LLM (Optional — deterministic fallback operates when absent)
# ANTHROPIC_API_KEY=sk-ant-...

# Vision Intelligence Provider
# Options: "heuristic" (zero-dependency, instant local analysis) or "huggingface" (Hugging Face Inference API / SigLIP / CLIP)
VISION_PROVIDER=heuristic
# VISION_API_KEY=hf_...
# VISION_MODEL=openai/clip-vit-base-patch32

# Vector Search & Embeddings Storage
EMBEDDING_STORAGE=file
EMBEDDING_FILE=catalog-embeddings.json

# Email / Verification OTP Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=your_email@gmail.com
