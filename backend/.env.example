# Backend Environment Variables
# Copy this file to .env and update values as needed

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENV=development

# CORS Configuration
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000

# Database
# SQLite (default) or PostgreSQL connection string
# DATABASE_URL=sqlite:///./meesho_sakhi.db
DATABASE_URL=sqlite:///./meesho_sakhi.db

# API Keys (if integrating with external services)
# OPENAI_API_KEY=your_key_here
# MEESHO_API_KEY=your_key_here (when available)

# Feature Flags
ENABLE_MEESHO_INTEGRATION=false
ENABLE_PAYMENT_PROCESSING=false

# Logging
LOG_LEVEL=INFO
