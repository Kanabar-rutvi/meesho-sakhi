# ═══════════════════════════════════════════════════════════════════
#  Sakhi — Comprehensive .gitignore
# ═══════════════════════════════════════════════════════════════════

# ─── Dependencies ─────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js
.yarn/

# ─── Build Output & Bundles ───────────────────────────────────────
dist/
build/
.vite/
*.tsbuildinfo
frontend/dist/
backend/dist/
admin/dist/
admin-frontend/dist/

# ─── Environment / Secrets (CRITICAL — never commit) ─────────────
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example
*.pem
*.key
*.cert

# ─── Admin Panel & Internal Panels ────────────────────────────────
admin-frontend/
admin/
backend/create-new-admin.cjs
backend/reset-admin.cjs

# ─── Test & Debug Scripts ─────────────────────────────────────────
backend/manual_test.js
backend/test_*.js

# ─── Generated Reports & Audit Outputs ────────────────────────────
*-report.html
*-report.json
backend/*-report.*
catalog-quality-report.*
catalog-validation-report.*

# ─── Scratch, Temporary & Backup Files ────────────────────────────
scratch/
*.backup.json
*.bak
*.tmp
*.temp.js
*.scratch.js
generate_*.cjs
.tempmediaStorage/

# ─── Internal Documentation ──────────────────────────────────────
DEPLOYMENT_CHECKLIST.md
PRD_and_Roadmap.md
docs/

# ─── Prisma & Local Databases ─────────────────────────────────────
prisma/migrations/
backend/prisma/migrations/
*.db
*.sqlite
*.sqlite3
*.db-journal
backend/prisma/dev.db

# ─── Python cache / virtual environments ─────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
ENV/

# ─── IDE & Editor ────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# ─── OS Files ────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db
ehthumbs_vista.db

# ─── Vercel & Hosting local config ───────────────────────────────
.vercel/

# ─── Logs ────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# ─── Coverage & Test Output ──────────────────────────────────────
coverage/
.nyc_output/
*.lcov

# ─── Miscellaneous Caches ────────────────────────────────────────
*.tgz
*.tar.gz
.eslintcache
.cache/