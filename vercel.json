{
  "version": 2,
  "buildCommand": "npm run build",
  "installCommand": "npm run install:all",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/[[...meesho]].js": {
      "maxDuration": 60,
      "includeFiles": "backend/**/*"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/[[...meesho]]"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
